[ "${1:-live}" != "live" ] && exit 0

setup_overlay || exit 1
mount_squashfs || exit 1

[ "$initrd_debug" = "2" ] && debug_shell 2 "After zram, scan & squashfs"

mount_overlay || exit 1
run_live_config
setup_newroot || exit 1

[ "$initrd_debug" = "3" ] && debug_shell 3 "After overlay and new root config"
