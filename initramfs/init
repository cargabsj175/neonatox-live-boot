#!/bin/sh
PATH=/sbin:/bin:/usr/bin:/usr/sbin
[ "$debug" = "1" ] && set -x

# --------------------------------------------------
# Config
# --------------------------------------------------
# Colors (TTY safe)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Global
ISO_MNT="/mnt/iso"
ISO_TEST="/mnt/iso_test"
FOUND_DEV=""
VENTOY_MODE=0


# --------------------------------------------------
# Core functions
# --------------------------------------------------
emergency_shell() {
	
    echo -e "${RED}[EMERGENCY]${NC} Dropping to shell"
    exec sh
}

echo -e "${YELLOW}================================================================${NC}"
echo -e "${YELLOW}=====${NC} ${GREEN}Neonatox Live Boot - v0.5 Carlos Sanchez - 2007-2026 ${YELLOW}=====${NC}"
echo -e "${YELLOW}================================================================${NC}"

# Checking if rootfs.sha256 exists
if [ ! -f /rootfs.sha256 ]; then
    echo -e "${RED}[ERROR]${NC} rootfs.sha256 missing"
    emergency_shell
fi
ROOTFS_HASH="$(cat /rootfs.sha256)"


# Boot on initramfs for debugging
[ "$initrd_debug" = "1" ] && emergency_shell

# --------------------------------------------------
# 1. Console and virtual filesystem
# --------------------------------------------------
mount -t proc proc /proc
mount -t sysfs sysfs /sys
sleep 1
mdev -s
mount -t tmpfs tmpfs /run

echo -e "${GREEN}[OK]${NC} basic mounts ready"

# --------------------------------------------------
# 2. Create loop devices
# --------------------------------------------------
for i in 0 1 2 3 4 5 6 7; do
    [ -b /dev/loop$i ] || mknod /dev/loop$i b 7 $i
done

# --------------------------------------------------
# 3. Load modules
# --------------------------------------------------
FILESYSTEMS="iso9660 squashfs overlay vfat fat exfat ntfs3"
MEDIA="loop cdrom sd_mod sr_mod usb-storage uas ahci libata zram" # Core devices
LEGACY="ata_piix pata_generic" # old IDE
NVME="nvme nvme_core" # modern NVMe
HID="hid-generic usbhid i8042 atkbd libps2" # Keyboard

for m in $FILESYSTEMS $MEDIA $LEGACY $NVME $HID; do
    modprobe $m 2>/dev/null
done

sleep 0.5
mdev -s

# --------------------------------------------------
# 4. Zram swap
# --------------------------------------------------

TOTAL_KB=$(awk '/MemTotal/ {print $2}' /proc/meminfo)

# Do not enable zram on extremely small systems
if [ "$TOTAL_KB" -lt 524288 ]; then
  echo -e "${YELLOW}[INFO]${NC} RAM < 512MB, zram disabled"
  :
else
  # Calculate size in KB
  if [ "$TOTAL_KB" -lt 1048576 ]; then        # < 1 GB
    ZRAM_KB=$((TOTAL_KB * 3 / 4))
  elif [ "$TOTAL_KB" -lt 4194304 ]; then      # 1–4 GB
    ZRAM_KB=$((TOTAL_KB / 2))
  else                                        # > 4 GB
    ZRAM_KB=2097152                            # cap 2 GB
  fi

  ZRAM_BYTES=$((ZRAM_KB * 1024))

  echo -e "${YELLOW}[INFO]${NC} Configuring zram (${ZRAM_KB} KB)"

  # Verify that the module is loaded
  if ! lsmod | grep -q "^zram"; then
    echo -e "${YELLOW}[INFO]${NC} zram module not loaded, skipping swap"
  # Verify that the device exists in sysfs
  elif [ ! -e /sys/block/zram0 ]; then
    echo -e "${YELLOW}[INFO]${NC} zram device not present in sysfs"
  else
    # Secure node in /dev
    if [ ! -b /dev/zram0 ]; then
      if [ -e /sys/block/zram0/dev ]; then
        read MAJOR MINOR < /sys/block/zram0/dev
        mknod /dev/zram0 b "$MAJOR" "$MINOR" 2>/dev/null
        chmod 660 /dev/zram0
      fi
    fi

    if [ -b /dev/zram0 ]; then
      # Choose algorithm if possible
      if [ -e /sys/block/zram0/comp_algorithm ]; then
        if grep -q "\[lz4\]" /sys/block/zram0/comp_algorithm 2>/dev/null; then
          echo lz4 > /sys/block/zram0/comp_algorithm
          ALGO="lz4"
        elif grep -q "\[lzo\]" /sys/block/zram0/comp_algorithm 2>/dev/null; then
          echo lzo > /sys/block/zram0/comp_algorithm
          ALGO="lzo"
        fi
      fi

      # Set size (IN BYTES)
      if echo "$ZRAM_BYTES" > /sys/block/zram0/disksize 2>/dev/null; then
        if mkswap /dev/zram0 >/dev/null 2>&1; then
          if swapon -p 5 /dev/zram0 >/dev/null 2>&1; then
            echo -e "${GREEN}[OK]${NC} zram swap enabled (${ZRAM_KB} KB, ${ALGO:-default})"
          else
            echo -e "${YELLOW}[WARN]${NC} swapon failed on zram"
          fi
        else
          echo -e "${YELLOW}[WARN]${NC} mkswap failed on zram"
        fi
      else
        echo -e "${YELLOW}[WARN]${NC} could not set zram disksize"
      fi
    else
      echo -e "${YELLOW}[WARN]${NC} /dev/zram0 not available"
    fi
  fi
fi

# --------------------------------------------------
# 5. Detect Ventoy environment
# --------------------------------------------------

if [ -d /ventoy ] || [ -d /vtoy ]; then
    echo -e "${YELLOW}[INFO]${NC} Ventoy environment detected"
    VENTOY_MODE=1
fi

# --------------------------------------------------
# 6. Scan devices (3 attempts)
# --------------------------------------------------
echo -e "${YELLOW}[INFO]${NC} scanning for boot media..."

for attempt in 1 2 3; do
    echo "  attempt $attempt/3"

    # NVMe doesn't need scanning, just wait a little while
    [ $attempt -eq 1 ] && sleep 0.5
    # SCSI scan (SATA, USB)
    for host in /sys/class/scsi_host/host*; do
        echo "- - -" > "$host/scan" 2>/dev/null || true
    done

    sleep 0.5
    mdev -s

    # Search in ORDER: CD/DVD first, then partitions
    for DEV in \
        /dev/sr* \
        /dev/nvme*n*p* /dev/nvme*n \
        /dev/sd* \
        /dev/hd* \
        /dev/mmcblk*p* /dev/mmcblk*
    do
        [ -e "$DEV" ] || continue

        echo "    probing $DEV"
        mount -o ro "$DEV" "$ISO_MNT" 2>/dev/null || continue

        # --------------------------------------------------
        # A) Normal ISO (rootfs directly)
        # --------------------------------------------------
        if [ -f "$ISO_MNT/rootfs.squashfs" ]; then
            FOUND_DEV="$DEV"
                break 2  # Break both loops
        fi
        # --------------------------------------------------
        # B) Ventoy: partition with ISOs in root
        # --------------------------------------------------
        if [ "$VENTOY_MODE" = "1" ]; then

            # Are there any ISOs in the root of this partition?
            if ls "$ISO_MNT"/*.iso >/dev/null 2>&1; then
                echo -e "${YELLOW}[INFO]${NC} ISO partition detected on $DEV"
        
                for ISO in "$ISO_MNT"/*.iso; do
                    echo "      testing ISO $(basename "$ISO")"
                    # Hack: The busybox losetup applet does not have the --show argument
                    LOOP="$(losetup -f "$ISO" && losetup -a | grep "$ISO" | sed 's/:.*//')" || continue
        
                    mount -o ro "$LOOP" "$ISO_TEST" 2>/dev/null || {
                        losetup -d "$LOOP"
                        continue
                    }

                    if [ -f "$ISO_TEST/rootfs.squashfs" ]; then
                        HASH="$(sha256sum "$ISO_TEST/rootfs.squashfs" | awk '{print $1}')"
                        
                        echo -e "${YELLOW}[INFO]${NC} rootfs.squashfs found on $(basename "$ISO")" 
                        if [ "$HASH" = "$ROOTFS_HASH" ]; then
                            echo -e "${GREEN}[OK]${NC} matching ISO found via SHA256"
                            FOUND_DEV="ventoy_iso"
                            ISO_MNT="$ISO_TEST"
                            break 3
                        fi
                    fi
                    if [ "$FOUND_DEV" != "ventoy_iso" ]; then
                        umount "$ISO_TEST" 2>/dev/null
                        losetup -d "$LOOP" 2>/dev/null
                    fi
                done
            fi
        fi
        # Unmount only if it is NOT the correct Ventoy ISO
        if [ "$FOUND_DEV" != "ventoy_iso" ]; then
            umount "$ISO_MNT" 2>/dev/null || umount -l "$ISO_MNT"
        fi
    done
done
# --------------------------------------------------
# 7. Fail if not found
# --------------------------------------------------
if [ -z "$FOUND_DEV" ]; then
    echo -e "${RED}[ERROR]${NC} rootfs.squashfs not found"
    # echo "Available devices:" # Debug purposes
    # ls -l /dev/sd* /dev/hd* /dev/nvme* /dev/mmcblk* /dev/sr* 2>/dev/null || true # Debug purposes
    emergency_shell
fi

echo -e "${GREEN}[OK]${NC} found boot media at $FOUND_DEV"

# --------------------------------------------------
# 8. Mount squashfs
# --------------------------------------------------
mkdir -p /mnt/ro_root

if [ "$FOUND_DEV" = "ventoy_iso" ]; then
    echo -e "${YELLOW}[INFO]${NC} mounting squashfs from Ventoy ISO"
    mount -t squashfs "$ISO_MNT/rootfs.squashfs" /mnt/ro_root || emergency_shell
else
    echo -e "${YELLOW}[INFO]${NC} mounting squashfs from physical media"
    mount -t squashfs -o loop "$ISO_MNT/rootfs.squashfs" /mnt/ro_root || emergency_shell
fi

echo -e "${GREEN}[OK]${NC} squashfs mounted"

# ---------------------------------------------
# 9. OverlayFS
# ---------------------------------------------
mkdir -p /mnt/ram
mkdir -p /mnt/newroot

mount -t tmpfs tmpfs /mnt/ram || {
    echo -e "${RED}[ERROR]${NC} tmpfs mount failed"
    emergency_shell
}

mkdir -p /mnt/ram/upper
mkdir -p /mnt/ram/work

mount -t overlay overlay \
    -o lowerdir=/mnt/ro_root,upperdir=/mnt/ram/upper,workdir=/mnt/ram/work \
    /mnt/newroot || {
        echo -e "${RED}[ERROR]${NC} overlay mount failed"
        emergency_shell
    }

echo -e "${GREEN}[OK]${NC} overlay mounted"

# --------------------------------------------------
# 9.5 Live Configuration (opcional)
# --------------------------------------------------
if echo "$(cat /proc/cmdline)" | grep -q "neoconfig=1"; then
    echo -e "${YELLOW}[INFO]${NC} Running Live configuration..."
    if [ -x /live-config.sh ]; then
        /live-config.sh
    fi
fi

# --------------------------------------------------
# 10. New root virtual filesystems
# --------------------------------------------------
mkdir -p /mnt/newroot/proc
mkdir -p /mnt/newroot/sys
mkdir -p /mnt/newroot/dev
mkdir -p /mnt/newroot/run

mount -t proc  proc  /mnt/newroot/proc
mount -t sysfs sysfs /mnt/newroot/sys
mount -t devtmpfs devtmpfs /mnt/newroot/dev
mkdir -p /mnt/newroot/dev/pts
mount -t devpts devpts -o gid=5,mode=0620 /mnt/newroot/dev/pts
mount -t tmpfs tmpfs /mnt/newroot/run

# --------------------------------------------------
# 11. machine-id (systemd) & minimal fstab
# --------------------------------------------------
if [ -x /mnt/newroot/lib/systemd/systemd ]; then
    mkdir -p /mnt/newroot/etc
    [ -f /mnt/newroot/etc/machine-id ] || touch /mnt/newroot/etc/machine-id
fi

cat > /mnt/newroot/etc/fstab <<EOF
proc  /proc  proc  defaults  0 0
sysfs /sys   sysfs defaults  0 0
devpts /dev/pts devpts defaults  0 0
tmpfs /run   tmpfs defaults  0 0
EOF

# --------------------------------------------------
# 12. Switch root (universal)
# --------------------------------------------------
if [ "$FOUND_DEV" != "ventoy_iso" ]; then
    umount "$ISO_TEST" 2>/dev/null || true
fi

if [ -x /mnt/newroot/lib/systemd/systemd ]; then
    echo "[BOOT] starting systemd"
    exec switch_root /mnt/newroot /lib/systemd/systemd
elif [ -x /mnt/newroot/sbin/init ]; then
    echo "[BOOT] starting init"
    exec switch_root /mnt/newroot /sbin/init
else
    echo "[FATAL] no init found"
    emergency_shell
fi
